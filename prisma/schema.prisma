generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum SharePermission {
  READ
  COMMENT
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  fullName     String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  memberships  WorkspaceMember[]
  refreshTokens RefreshToken[]
  assignedTasks Task[]            @relation("TaskAssignee")
  comments     Comment[]
  favorites    Favorite[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  pages     Page[]
  tasks     Task[]
  databases Database[]
  shares    PageShare[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @default(EDITOR)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Page {
  id          String     @id @default(uuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Page?      @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Page[]     @relation("PageTree")
  title       String     @default("Adsız")
  icon        String?
  contentVersion Int     @default(1)
  isFavorite  Boolean    @default(false)
  isTemplate  Boolean    @default(false)
  templateKey String?
  trashedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  blocks      Block[]
  tasks       Task[]
  linksFrom   PageLink[] @relation("LinkFrom")
  linksTo     PageLink[] @relation("LinkTo")
  shares      PageShare[]
  comments    Comment[]
  favorites   Favorite[]
  database    Database?

  @@index([workspaceId, parentId])
  @@index([workspaceId, trashedAt])
}

model Block {
  id            String   @id @default(uuid())
  pageId        String
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentBlockId String?
  parentBlock   Block?   @relation("BlockTree", fields: [parentBlockId], references: [id], onDelete: Cascade)
  children      Block[]  @relation("BlockTree")
  type          String
  props         Json     @default("{}")
  sortOrder     Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  comments      Comment[]

  @@index([pageId, sortOrder])
}

model PageLink {
  id           String   @id @default(uuid())
  fromPageId   String
  fromPage     Page     @relation("LinkFrom", fields: [fromPageId], references: [id], onDelete: Cascade)
  toPageId     String
  toPage       Page     @relation("LinkTo", fields: [toPageId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([fromPageId, toPageId])
  @@index([toPageId])
}

model Task {
  id           String     @id @default(uuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pageId       String?
  page         Page?      @relation(fields: [pageId], references: [id], onDelete: SetNull)
  title        String
  status       TaskStatus @default(TODO)
  dueAt        DateTime?
  assigneeId   String?
  assignee     User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sortOrder    Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([workspaceId, pageId])
  @@index([workspaceId, status])
}

model Database {
  id          String             @id @default(uuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pageId      String             @unique
  page        Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  name        String             @default("Veritabanı")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  properties  DatabaseProperty[]
  rows        DatabaseRow[]
  views       DatabaseView[]
}

model DatabaseProperty {
  id         String   @id @default(uuid())
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name       String
  type       String
  options    Json     @default("[]")
  sortOrder  Float    @default(0)

  @@index([databaseId])
}

model DatabaseRow {
  id         String   @id @default(uuid())
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  values     Json     @default("{}")
  sortOrder  Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([databaseId])
}

model DatabaseView {
  id         String   @id @default(uuid())
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name       String
  type       String   @default("table")
  config     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([databaseId])
}

model PageShare {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pageId      String
  page        Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  token       String          @unique @default(uuid())
  permission  SharePermission @default(READ)
  createdAt   DateTime        @default(now())

  @@index([pageId])
}

model Comment {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockId   String?
  block     Block?   @relation(fields: [blockId], references: [id], onDelete: SetNull)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, pageId])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
